            </div>

            <div class="panel-card" style="padding: 24px;">
              <h3 style="font-size: 15px; font-weight: 700; margin-bottom: 16px;">Regional & Timezone</h3>
              <div style="display: flex; justify-content: space-between; align-items: center;">
                <div>
                  <div style="font-weight: 600; font-size: 13px;">Timezone Standard</div>
                  <div style="font-size: 12px; color: var(--text-muted);">Asia/Kolkata (IST - UTC+05:30)</div>
                </div>
                <span class="badge badge-on">Configured</span>
              </div>
            </div>
          </div>
        </section>

      </main>

      <!-- APPLICATION FOOTER -->
      <footer class="app-footer">
        <div>SPARK DRIVES & AUTOMATION • Precision Industrial IoT Platform • © 2026 • Coimbatore, India</div>
      </footer>
    </div>
  </div>

  <!-- TOAST CONTAINER FOR INDUSTRIAL NOTIFICATIONS -->
  <div id="toast-container" class="toast-container"></div>

  <!-- FIREBASE CONFIG & INITIALIZATION -->
