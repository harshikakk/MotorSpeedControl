        <section id="page-control" class="page-view" style="display: none;">
          <div class="page-hero">
            <h1>Device Control Terminal</h1>
            <p>Real-time bidirectional device control for ESP32 and MX1508 H-Bridge.</p>
          </div>

          <div style="max-width: 680px; margin: 0 auto;">
            <div class="panel-card">
              <div class="panel-header">
                <div>
                  <div style="font-size:16px; font-weight:700;">Target Controller: ESP32-MOTOR-001</div>
                  <div style="font-size:12px; color:var(--text-muted);">Actuator Pins: GPIO 25 (IN3), GPIO 26 (IN4)</div>
                </div>
                <span id="ctrl-panel-badge" class="badge badge-on">● Hardware Ready</span>
              </div>

              <div class="led-control-box" style="padding: 36px 20px;">
                <!-- Glowing Virtual Actuator -->
                <div id="ctrl-virtual-lamp" class="virtual-led-lamp"></div>

                <div class="led-status-caption">
                  Physical Output: <span id="ctrl-status-text" style="color:var(--text-secondary);">OFF</span>
                </div>
                <div class="led-device-tag">Bidirectional Sync Active with PIStudio HMI</div>

                <!-- Master Toggle Switch -->
                <div class="master-toggle-wrapper">
                  <span class="toggle-state-label" id="ctrl-toggle-lbl-off">OFF</span>
                  <label class="switch-control">
                    <input type="checkbox" id="ctrl-motor-toggle">
                    <span class="switch-slider"></span>
                  </label>
                  <span class="toggle-state-label" id="ctrl-toggle-lbl-on">ON</span>
                </div>

                <!-- Pushbutton Pair -->
                <div style="display: flex; gap: 12px; width: 100%; max-width: 440px; margin: 16px 0;">
                  <button id="ctrl-start-btn" class="btn-primary" style="flex:1; background:var(--status-green);">
                    <i data-lucide="play" style="width:16px; height:16px;"></i> START
                  </button>
                  <button id="ctrl-stop-btn" class="btn-primary" style="flex:1; background:var(--status-red);">
                    <i data-lucide="square" style="width:16px; height:16px;"></i> STOP
                  </button>
                </div>

                <!-- Speed Control Slider -->
                <div class="speed-slider-wrap" style="width: 100%; max-width: 440px;">
                  <div style="display: flex; justify-content: space-between; align-items:center; margin-bottom: 8px;">
                    <span style="font-size: 13px; font-weight: 700;">Motor Speed:</span>
                    <span id="ctrl-speed-val" style="font-size: 18px; font-weight: 800; color: var(--brand-primary);">0%</span>
                  </div>
                  <input type="range" id="ctrl-speed-slider" class="motor-speed-slider" min="0" max="100" value="0">
                  
                  <div class="preset-btn-group">
                    <button class="preset-speed-btn" onclick="window.setMotorPresetSpeed(25)">25%</button>
                    <button class="preset-speed-btn" onclick="window.setMotorPresetSpeed(50)">50%</button>
                    <button class="preset-speed-btn" onclick="window.setMotorPresetSpeed(75)">75%</button>
                    <button class="preset-speed-btn" onclick="window.setMotorPresetSpeed(100)">100%</button>
                  </div>

                  <div class="direction-toggle-group">
                    <button id="ctrl-dir-fwd" class="dir-btn active" onclick="window.setMotorDirection('FORWARD')">
                      <i data-lucide="arrow-right" style="width:14px; height:14px;"></i> Forward
                    </button>
                    <button id="ctrl-dir-rev" class="dir-btn" onclick="window.setMotorDirection('REVERSE')">
                      <i data-lucide="arrow-left" style="width:14px; height:14px;"></i> Reverse
                    </button>
                  </div>
                </div>

                <!-- Telemetry Row -->
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; width: 100%; max-width: 440px; margin-top: 10px;">
                  <div style="background:var(--bg-subtle); padding:10px; border-radius:var(--radius-sm); text-align:center;">
                    <div style="font-size:11px; color:var(--text-muted); text-transform:uppercase;">Control Source</div>
                    <div id="ctrl-source" style="font-weight:700; font-size:13px;">Website</div>
                  </div>
                  <div style="background:var(--bg-subtle); padding:10px; border-radius:var(--radius-sm); text-align:center;">
                    <div style="font-size:11px; color:var(--text-muted); text-transform:uppercase;">Applied PWM</div>
                    <div id="ctrl-applied-pwm" style="font-weight:700; font-size:13px; color:var(--brand-primary);">0 / 255</div>
                  </div>
                </div>
              </div>

            </div>
          </div>
