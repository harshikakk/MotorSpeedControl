<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Industrial IoT Control Center | Spark Drives & Automation</title>
  
  <!-- Favicon / Branding -->
  <link rel="icon" href="https://5.imimg.com/data5/SELLER/Banner/2021/10/QW/NP/LH/58996682/favicon.ico">
  
  <!-- Google Fonts: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <!-- SheetJS for Exporting to Real Excel (.xlsx) -->
  <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>

  <!-- Chart.js for Industrial IoT Visualizations -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <!-- Firebase v10 Compat SDKs -->
  <script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-auth-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-database-compat.js"></script>

  <!-- Application Stylesheet (Clean Light Corporate Theme) -->
  <link rel="stylesheet" href="styles.css">

  <style>
    /* Speed Control & Actuator Enhancements */
    .speed-slider-wrap {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 16px 20px;
      margin: 16px 0;
    }
    .motor-speed-slider {
      -webkit-appearance: none;
      width: 100%;
      height: 8px;
      border-radius: 4px;
      background: var(--border-color);
      outline: none;
      transition: background 0.2s;
    }
    .motor-speed-slider::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: var(--brand-primary);
      cursor: pointer;
      box-shadow: 0 2px 6px rgba(2, 132, 199, 0.4);
      border: 2px solid #ffffff;
      transition: transform 0.1s;
    }
    .motor-speed-slider::-webkit-slider-thumb:hover {
      transform: scale(1.15);
    }
    .preset-btn-group {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 8px;
      margin-top: 12px;
    }
    .preset-speed-btn {
      padding: 8px 12px;
      border-radius: var(--radius-sm);
      border: 1px solid var(--border-color);
      background: #ffffff;
      font-weight: 600;
      font-size: 13px;
      color: var(--text-secondary);
      cursor: pointer;
      transition: all 0.15s ease;
      text-align: center;
    }
    .preset-speed-btn:hover {
      border-color: var(--brand-primary);
      color: var(--brand-primary);
      background: var(--brand-light);
    }
    .preset-speed-btn.active {
      background: var(--brand-primary);
      color: #ffffff;
      border-color: var(--brand-primary);
    }
    .direction-toggle-group {
      display: flex;
      gap: 8px;
      margin-top: 12px;
    }
    .dir-btn {
      flex: 1;
      padding: 8px 14px;
      border-radius: var(--radius-sm);
      border: 1px solid var(--border-color);
      background: #ffffff;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      color: var(--text-secondary);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      transition: all 0.15s;
    }
    .dir-btn:hover {
      border-color: var(--brand-primary);
      color: var(--brand-primary);
    }
    .dir-btn.active {
      background: var(--brand-light);
      border-color: var(--brand-primary);
      color: var(--brand-primary);
      font-weight: 700;
    }
  </style>
</head>
<body>

  <!-- ========================================================================
       1. AUTHENTICATION VIEW (Clean Corporate Light Login Page)
       ======================================================================== -->
  <div id="auth-view" class="auth-wrapper" style="display: flex;">
    <!-- Left Hero Pane -->
    <div class="auth-hero-pane">
      <div class="hero-brand">
        <div class="brand-badge">S</div>
        <div class="hero-brand-text">
          <h1>Spark Drives & Automation</h1>
          <span>Industrial Automation & IoT Solutions</span>
        </div>
      </div>

      <div class="hero-content">
        <div class="hero-tag">
          <i data-lucide="shield-check" style="width:14px; height:14px;"></i> Enterprise Industrial Platform
        </div>
        <h2>Precision IoT Control & Automated Monitoring</h2>
        <p>
          Seamlessly bridge physical automation hardware with cloud intelligence. 
          Manage real-time telemetry, bi-directional control channels, and fieldbus systems.
        </p>

        <div class="hero-features">
          <div class="feature-pill">
            <i data-lucide="cpu" style="width:20px; height:20px;"></i>
            <div>
              <h4>Edge Controller Sync</h4>
              <p>ESP32 & Field Controller integration</p>
            </div>
          </div>
          <div class="feature-pill">
            <i data-lucide="activity" style="width:20px; height:20px;"></i>
            <div>
              <h4>Sub-Second Telemetry</h4>
              <p>Google Firebase RTDB backbone</p>
            </div>
          </div>
          <div class="feature-pill">
            <i data-lucide="sliders" style="width:20px; height:20px;"></i>
            <div>
              <h4>HMI & Web Dual Sync</h4>
              <p>Unified state across all interfaces</p>
            </div>
          </div>
          <div class="feature-pill">
            <i data-lucide="file-spreadsheet" style="width:20px; height:20px;"></i>
            <div>
              <h4>Audit History & Excel</h4>
              <p>Full event tracking and reporting</p>
            </div>
          </div>
        </div>
      </div>

      <div class="hero-footer">
        <span>Coimbatore, Tamil Nadu • GST: 33ALCPP9746R2Z7</span>
        <a href="https://www.sparkdna.co.in/" target="_blank" rel="noopener noreferrer">Official Website &rarr;</a>
      </div>
    </div>

    <!-- Right Login Card Pane -->
    <div class="auth-form-pane">
      <div class="auth-card">
        <div class="auth-header">
          <h3>Welcome Back</h3>
          <p>Sign in to access the Industrial IoT Control Center.</p>
        </div>

        <div id="login-alert" class="auth-alert" style="display: none;"></div>

        <form id="login-form">
          <div class="form-group">
            <label class="form-label" for="login-email">Authorized Email Address</label>
            <div class="form-input-wrap">
              <span class="input-icon-left"><i data-lucide="mail" style="width:16px; height:16px;"></i></span>
              <input type="email" id="login-email" class="form-input" placeholder="name@sparkdna.co.in" required autocomplete="email">
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="login-password">Operator Password</label>
            <div class="form-input-wrap">
              <span class="input-icon-left"><i data-lucide="lock" style="width:16px; height:16px;"></i></span>
              <input type="password" id="login-password" class="form-input" placeholder="Enter your password" required autocomplete="current-password">
              <button type="button" id="toggle-password-btn" class="password-toggle-btn">Show</button>
            </div>
          </div>

          <div class="form-actions-bar">
            <button type="button" id="forgot-password-btn" class="forgot-password-link">Forgot Password?</button>
          </div>

          <button type="submit" id="login-submit-btn" class="btn-primary">
            <span>Sign In to Control Center</span>
            <i data-lucide="arrow-right" style="width:16px; height:16px;"></i>
          </button>
        </form>

        <div class="auth-card-footer">
          <p>SPARK DRIVES & AUTOMATION • SECURE INDUSTRIAL PORTAL</p>
        </div>
      </div>
    </div>
  </div>

  <!-- ========================================================================
       2. AUTHENTICATED APPLICATION SHELL
       ======================================================================== -->
  <div id="app-view" class="app-layout" style="display: none;">
    
    <!-- FIXED LEFT SIDEBAR -->
    <aside id="app-sidebar" class="app-sidebar">
      <div class="sidebar-header">
        <a href="#dashboard" class="sidebar-brand">
          <div class="brand-icon-sq">S</div>
          <div class="brand-title-wrap">
            <span class="brand-title">SPARK DRIVES</span>
            <span class="brand-sub">IoT Control Platform</span>
          </div>
        </a>
        <button id="sidebar-toggle-btn" class="sidebar-toggle-btn" title="Toggle Sidebar">
          <i data-lucide="chevrons-left" style="width:16px; height:16px;"></i>
        </button>
      </div>

      <div class="sidebar-nav-container">
        <div class="nav-section-title">Main</div>
        <a href="#dashboard" class="nav-item active" data-route="dashboard">
          <span class="nav-icon"><i data-lucide="layout-grid" style="width:18px; height:18px;"></i></span>
          <span class="nav-label">Dashboard</span>
        </a>

        <div class="nav-section-title">Devices</div>
        <a href="#devices" class="nav-item" data-route="devices">
          <span class="nav-icon"><i data-lucide="cpu" style="width:18px; height:18px;"></i></span>
          <span class="nav-label">Connected Devices</span>
        </a>
        <a href="#control" class="nav-item" data-route="control">
          <span class="nav-icon"><i data-lucide="sliders" style="width:18px; height:18px;"></i></span>
          <span class="nav-label">Device Control</span>
        </a>

        <div class="nav-section-title">Monitoring</div>
        <a href="#history" class="nav-item" data-route="history">
          <span class="nav-icon"><i data-lucide="history" style="width:18px; height:18px;"></i></span>
          <span class="nav-label">Operation History</span>
        </a>
        <a href="#analytics" class="nav-item" data-route="analytics">
          <span class="nav-icon"><i data-lucide="bar-chart-3" style="width:18px; height:18px;"></i></span>
          <span class="nav-label">System Analytics</span>
        </a>
        <a href="#status" class="nav-item" data-route="status">
          <span class="nav-icon"><i data-lucide="activity" style="width:18px; height:18px;"></i></span>
          <span class="nav-label">System Status</span>
        </a>

        <div class="nav-section-title">Company</div>
        <a href="#company" class="nav-item" data-route="company">
          <span class="nav-icon"><i data-lucide="building-2" style="width:18px; height:18px;"></i></span>
          <span class="nav-label">Company Profile</span>
        </a>

        <div class="nav-section-title">Account</div>
        <a href="#profile" class="nav-item" data-route="profile">
          <span class="nav-icon"><i data-lucide="user" style="width:18px; height:18px;"></i></span>
          <span class="nav-label">My Profile</span>
        </a>
        <a href="#settings" class="nav-item" data-route="settings">
          <span class="nav-icon"><i data-lucide="settings" style="width:18px; height:18px;"></i></span>
          <span class="nav-label">Settings</span>
        </a>
      </div>

      <div class="sidebar-footer">
        <div class="system-status-indicator">
          <div id="sidebar-status-dot" class="pulse-dot connecting"></div>
          <div class="system-status-text">
            <span id="sidebar-status-text">Connecting Gateway...</span>
            <span>ESP32 Hardware Link</span>
          </div>
        </div>
      </div>
    </aside>

    <!-- MAIN APP CANVAS & STICKY HEADER -->
    <div class="app-main">
      
      <!-- STICKY TOP HEADER -->
      <header class="app-header">
        <div class="header-left">
          <button id="mobile-menu-btn" class="mobile-menu-btn">
            <i data-lucide="menu" style="width:20px; height:20px;"></i>
          </button>
          <div class="page-title-box">
            <h2 id="header-page-title">Dashboard</h2>
            <div class="breadcrumb-trail">
              <a href="#dashboard">Home</a>
              <span>/</span>
              <span id="breadcrumb-current">Dashboard</span>
            </div>
          </div>
        </div>

        <div class="header-right">
          <!-- Dynamic IST Clock -->
          <div class="clock-chip">
            <i data-lucide="clock" style="width:14px; height:14px;"></i>
            <span id="live-clock">--:--:-- IST</span>
          </div>

          <!-- Live Connection Status Badges -->
          <div class="connection-status-group">
            <div id="firebase-conn-badge" class="conn-badge waiting">
              <span class="pulse-dot connecting"></span> Firebase Syncing
            </div>
            <div id="esp32-conn-badge" class="conn-badge waiting">
              <span class="pulse-dot connecting"></span> ESP32 Offline
            </div>
          </div>

          <!-- Notification Bell -->
          <div style="position: relative;">
            <button id="notif-btn" class="header-action-icon" title="Notifications">
              <i data-lucide="bell" style="width:18px; height:18px;"></i>
              <span id="notif-badge" class="notification-count" style="display: none;">0</span>
            </button>
            <div id="notif-dropdown" class="dropdown-flyout" style="width: 320px; right: 0;">
              <div class="dropdown-header-bar">
                <span>Notifications</span>
                <button id="mark-notifs-read-btn" style="background:none; border:none; color:var(--brand-primary); font-size:12px; cursor:pointer;">Mark all read</button>
              </div>
              <div id="notif-list" style="max-height: 280px; overflow-y: auto;">
                <div style="padding: 20px; text-align: center; color: var(--text-muted); font-size: 13px;">No unread alerts</div>
              </div>
            </div>
          </div>

          <!-- User Profile Dropdown -->
          <div class="user-profile-menu" style="position: relative;">
            <button id="user-dropdown-btn" class="user-profile-trigger">
              <div id="user-avatar-initial" class="user-avatar-circle">U</div>
              <div class="user-info-text">
                <span id="user-name-display" class="user-info-name">Authorized User</span>
                <span id="user-role-display" class="user-info-role">Operator</span>
              </div>
              <i data-lucide="chevron-down" style="width:14px; height:14px; color:var(--text-muted);"></i>
            </button>
            <div id="user-dropdown" class="dropdown-flyout" style="width: 200px; right: 0;">
              <div style="padding: 12px 16px; border-bottom: 1px solid var(--border-color);">
                <div id="dropdown-user-email" style="font-size: 12px; color: var(--text-muted); word-break: break-all;">user@sparkdna.co.in</div>
              </div>
              <a href="#profile" class="dropdown-item">
                <i data-lucide="user" style="width:14px; height:14px;"></i> My Profile
              </a>
              <a href="#settings" class="dropdown-item">
                <i data-lucide="settings" style="width:14px; height:14px;"></i> System Settings
              </a>
              <div style="border-top: 1px solid var(--border-color); margin: 4px 0;"></div>
              <button id="logout-btn" class="dropdown-item danger" style="width: 100%; border:none; background:none; text-align:left; cursor:pointer;">
                <i data-lucide="log-out" style="width:14px; height:14px;"></i> Sign Out
              </button>
            </div>
          </div>
        </div>
      </header>

      <!-- SCROLLABLE PAGE CANVAS -->
      <main class="content-body">

        <!-- ==================================================================
             PAGE 1: DASHBOARD
             ================================================================== -->
        <section id="page-dashboard" class="page-view">
          <div class="page-hero">
            <h1>Industrial IoT Control Center</h1>
            <p>Monitor, control and analyze connected automation devices in real time.</p>
          </div>

          <!-- 4 SUMMARY METRIC CARDS -->
          <div class="cards-row-4">
            <!-- Card 1: Motor / Actuator Status -->
            <div class="metric-card">
              <div class="metric-header">
                <span class="metric-title">Actuator State</span>
                <div class="metric-icon-box"><i data-lucide="power" style="width:16px; height:16px;"></i></div>
              </div>
              <div class="metric-value-row">
                <span id="dash-actuator-val" class="metric-main-value" style="color: var(--status-red);">OFF</span>
              </div>
              <div class="metric-sub-meta">
                <span>Device: <strong id="dash-actuator-dev">ESP32-MOTOR-001</strong></span>
                <span>Speed: <strong id="dash-actuator-speed">0% (PWM 0)</strong></span>
                <span>Source: <strong id="dash-actuator-source">Website</strong></span>
              </div>
            </div>

            <!-- Card 2: ESP32 Gateway -->
            <div class="metric-card">
              <div class="metric-header">
                <span class="metric-title">ESP32 Gateway</span>
                <div class="metric-icon-box"><i data-lucide="cpu" style="width:16px; height:16px;"></i></div>
              </div>
              <div class="metric-value-row">
                <span id="dash-esp-val" class="metric-main-value" style="color: var(--status-red);">OFFLINE</span>
              </div>
              <div class="metric-sub-meta">
                <span>IP: <strong id="dash-esp-ip">10.225.173.73</strong></span>
                <span>Wi-Fi: <strong id="dash-esp-wifi">Connected</strong></span>
                <span>Last Ping: <strong id="dash-esp-lastseen">--</strong></span>
              </div>
            </div>

            <!-- Card 3: Firebase RTDB -->
            <div class="metric-card">
              <div class="metric-header">
                <span class="metric-title">Cloud Backbone</span>
                <div class="metric-icon-box"><i data-lucide="cloud" style="width:16px; height:16px;"></i></div>
              </div>
              <div class="metric-value-row">
                <span id="dash-fb-val" class="metric-main-value" style="color: var(--status-green);">CONNECTED</span>
              </div>
              <div class="metric-sub-meta">
                <span>Project: <strong>harshini-feb82</strong></span>
                <span>Sync Stream: <strong id="dash-fb-sync">Sub-second Active</strong></span>
              </div>
            </div>

            <!-- Card 4: Today's Events -->
            <div class="metric-card">
              <div class="metric-header">
                <span class="metric-title">Audit Log Count</span>
                <div class="metric-icon-box"><i data-lucide="history" style="width:16px; height:16px;"></i></div>
              </div>
              <div class="metric-value-row">
                <span id="dash-today-events" class="metric-main-value">0</span>
              </div>
              <div class="metric-sub-meta">
                <span>Total Recorded Operations</span>
                <span>Bidirectional HMI + Web Sync</span>
              </div>
            </div>
          </div>

          <!-- DASHBOARD 2-COLUMN GRID: QUICK CONTROL & REAL-TIME ACTIVITY -->
          <div class="dashboard-grid-2">
            <!-- Left: Quick Motor Control Panel -->
            <div class="panel-card">
              <div class="panel-header">
                <h3 class="panel-title">Quick Actuator & Speed Control</h3>
                <span id="quick-status-badge" class="badge badge-off">● Standby</span>
              </div>

              <div class="led-control-box">
                <!-- Glowing Virtual Actuator Indicator -->
                <div id="dash-virtual-lamp" class="virtual-led-lamp"></div>

                <div class="led-status-caption">
                  Physical Output: <span id="dash-output-text" style="color:var(--text-secondary); font-weight:700;">OFF</span>
                </div>
                <div class="led-device-tag">ESP32 Pin: GPIO 25/26 (MX1508 IN3/IN4)</div>

                <!-- Master Toggle Switch -->
                <div class="master-toggle-wrapper">
                  <span class="toggle-state-label" id="lbl-toggle-off">OFF</span>
                  <label class="switch-control">
                    <input type="checkbox" id="dash-motor-toggle">
                    <span class="switch-slider"></span>
                  </label>
                  <span class="toggle-state-label" id="lbl-toggle-on">ON</span>
                </div>

                <!-- Speed Control Slider -->
                <div class="speed-slider-wrap" style="width: 100%; max-width: 440px;">
                  <div style="display: flex; justify-content: space-between; font-size: 13px; font-weight: 700; margin-bottom: 8px;">
                    <span>Adjust Speed Setpoint:</span>
                    <span id="dash-slider-speed-pct" style="color: var(--brand-primary); font-size: 16px;">0%</span>
                  </div>
                  <input type="range" id="dash-speed-slider" class="motor-speed-slider" min="0" max="100" value="0">
                  
                  <div class="preset-btn-group">
                    <button class="preset-speed-btn" onclick="window.setMotorPresetSpeed(25)">25%</button>
                    <button class="preset-speed-btn" onclick="window.setMotorPresetSpeed(50)">50%</button>
                    <button class="preset-speed-btn" onclick="window.setMotorPresetSpeed(75)">75%</button>
                    <button class="preset-speed-btn" onclick="window.setMotorPresetSpeed(100)">100%</button>
                  </div>

                  <div class="direction-toggle-group">
                    <button id="dash-dir-fwd" class="dir-btn active" onclick="window.setMotorDirection('FORWARD')">
                      <i data-lucide="arrow-right" style="width:14px; height:14px;"></i> Forward
                    </button>
                    <button id="dash-dir-rev" class="dir-btn" onclick="window.setMotorDirection('REVERSE')">
                      <i data-lucide="arrow-left" style="width:14px; height:14px;"></i> Reverse
                    </button>
                  </div>
                </div>

                <!-- Command Status Pipeline -->
                <div class="command-pipeline-box" style="width: 100%; max-width: 440px;">
                  <div class="pipeline-title">Command Execution Pipeline</div>
                  <div class="pipeline-steps-row">
                    <div class="pipeline-step">
                      <div id="pipe-step-req" class="pipeline-step-badge success">✓</div>
                      <div class="pipeline-step-label">Requested</div>
                      <div id="pipe-req-val" class="pipeline-step-sub">OFF @ 0%</div>
                    </div>
                    <div class="pipeline-arrow">&rarr;</div>
                    <div class="pipeline-step">
                      <div id="pipe-step-fb" class="pipeline-step-badge success">✓</div>
                      <div class="pipeline-step-label">Firebase</div>
                      <div class="pipeline-step-sub">Synced</div>
                    </div>
                    <div class="pipeline-arrow">&rarr;</div>
                    <div class="pipeline-step">
                      <div id="pipe-step-esp" class="pipeline-step-badge pending">●</div>
                      <div class="pipeline-step-label">ESP32</div>
                      <div id="pipe-esp-val" class="pipeline-step-sub">Awaiting</div>
                    </div>
                    <div class="pipeline-arrow">&rarr;</div>
                    <div class="pipeline-step">
                      <div id="pipe-step-act" class="pipeline-step-badge pending">●</div>
                      <div class="pipeline-step-label">Motor Output</div>
                      <div id="pipe-act-val" class="pipeline-step-sub">PWM: 0</div>
                    </div>
                  </div>
                </div>

              </div>
            </div>

            <!-- Right: Real Activity History Timeline -->
            <div class="panel-card">
              <div class="panel-header">
                <h3 class="panel-title">Recent Operation Activity</h3>
                <a href="#history" class="btn-filter-chip" style="text-decoration:none;">View Full History &rarr;</a>
              </div>

              <!-- Vertical Timeline of Real Recorded Events -->
              <div style="padding: 18px 24px;">
                <div id="dash-recent-timeline" class="timeline-list">
                  <div style="padding: 24px; text-align: center; color: var(--text-muted); font-size: 13px;">
                    Loading recent audit trail from Firebase...
                  </div>
                </div>

                <div style="margin-top: 24px; border-top: 1px solid var(--border-color); padding-top: 16px;">
                  <div style="font-size: 13px; font-weight: 700; margin-bottom: 12px; color: var(--text-secondary);">
                    Today's Operation Distribution
                  </div>
                  <div style="height: 180px;">
                    <canvas id="dash-activity-chart"></canvas>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- ==================================================================
             PAGE 2: CONNECTED DEVICES
             ================================================================== -->
